# ===== 飞书应用 =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书域名：国内 https://open.feishu.cn ；Lark 用 https://open.larksuite.com
FEISHU_BASE=https://open.feishu.cn

# ===== 豆包 / 火山方舟 =====
ARK_API_KEY=
# 接入点 ID（推荐）或模型名 doubao-seedream-5-0-260128
ARK_MODEL=
ARK_BASE=https://ark.cn-beijing.volces.com/api/v3

# ===== 业务配置 =====
TZ=Asia/Shanghai
# 每人生成几张候选图
CARDS_PER_EVENT=5
# 入职周年推送时间 / 生日推送时间（本地时区）
ANNIVERSARY_PUSH_TIME=10:00
BIRTHDAY_PUSH_TIME=11:00
# 周四几点跑生成任务（cron: 周四 20:00）
WEEKLY_CRON_DAY=thu
WEEKLY_CRON_TIME=20:00

# ===== 服务 =====
HOST=0.0.0.0
PORT=8848
# 审核页面口令（留空则不校验）
ADMIN_TOKEN=

# ===== 演练模式：True 时不真正调用飞书发消息，只写日志 =====
DRY_RUN=true
